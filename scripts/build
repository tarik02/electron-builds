#!/usr/bin/env python3

import datetime
import hashlib
import json
import os
import shlex
import shutil
import subprocess
import sys
import fcntl
from pathlib import Path


def run(*args: str, cwd: Path | None = None, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        cwd=cwd,
        check=True,
        text=True,
        capture_output=capture,
    )


def command_succeeds(*args: str) -> bool:
    return subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as file:
        for chunk in iter(lambda: file.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_dotenv(path: Path) -> None:
    output = run(
        "sops",
        "decrypt",
        "--input-type",
        "dotenv",
        "--output-type",
        "dotenv",
        str(path),
        capture=True,
    ).stdout
    for line in output.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, value = line.partition("=")
        if not separator:
            continue
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            parsed_value = shlex.split(value)
            value = parsed_value[0] if parsed_value else ""
        os.environ[key] = value


def required_env(name: str) -> str:
    value = os.environ.get(name)
    if not value:
        raise RuntimeError(f"{name} is required (configure secrets/aws.env)")
    return value


def apply_patch(repo: Path, patch: Path, patches: list[dict[str, str]]) -> None:
    run("git", "-C", str(repo), "apply", "--check", str(patch))
    run("git", "-C", str(repo), "apply", str(patch))
    patches.append({"name": patch.name, "sha256": sha256(patch)})


def main() -> int:
    if len(sys.argv) != 2:
        print(f"usage: {Path(sys.argv[0]).name} <major>", file=sys.stderr)
        return 2

    major = sys.argv[1]
    repo_root = Path(__file__).resolve().parents[1]
    matrix = json.loads((repo_root / "build-matrix.json").read_text())
    recipe = matrix[major]
    if not recipe["build"]:
        print(f"electron {major} is not scheduled: {recipe['reason']}")
        return 0

    build_root = Path(
        os.environ.get("ELECTRON_WORKSPACE")
        or Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "electron-build"
    ).expanduser()
    source_root = build_root / "src"
    electron_repo = source_root / "electron"
    out_dir = source_root / "out" / "Release"
    config_dir = Path(os.environ.get("EVM_CONFIG") or build_root / "config").expanduser()
    config_file = config_dir / "evm.main-release.json"
    git_cache = Path(os.environ.get("GIT_CACHE_PATH") or build_root / "git-cache").expanduser()
    secrets_file = Path(
        os.environ.get("ELECTRON_AWS_SECRETS_FILE") or repo_root / "secrets/aws.env"
    ).expanduser()

    if secrets_file.is_file():
        load_dotenv(secrets_file)

    garage_endpoint = required_env("GARAGE_ENDPOINT")
    garage_region = required_env("GARAGE_REGION")
    garage_bucket = required_env("GARAGE_BUCKET")
    garage_public_base_url = required_env("GARAGE_PUBLIC_BASE_URL")

    version = recipe["version"]
    tag = f"v{version}"
    build_root.mkdir(parents=True, exist_ok=True)
    source_root.mkdir(parents=True, exist_ok=True)
    (repo_root / "out" / major).mkdir(parents=True, exist_ok=True)

    lock = (build_root / ".build.lock").open("w")
    fcntl.flock(lock, fcntl.LOCK_EX)
    patches: list[dict[str, str]] = []

    def build_sources() -> None:
        config_dir.mkdir(parents=True, exist_ok=True)
        config = json.loads((repo_root / "config/evm.main-release.json").read_text())
        config["root"] = str(build_root)
        config["env"]["GIT_CACHE_PATH"] = str(git_cache)
        config["env"]["CHROMIUM_BUILDTOOLS_PATH"] = str(source_root / "buildtools")
        temporary_config = config_file.with_suffix(".json.tmp")
        temporary_config.write_text(json.dumps(config, indent=2) + "\n")
        temporary_config.replace(config_file)
        os.environ["EVM_CONFIG"] = str(config_dir)

        if not command_succeeds("git", "-C", str(electron_repo), "rev-parse", "--git-dir"):
            run(
                "git",
                "clone",
                "--filter=blob:none",
                "https://github.com/electron/electron.git",
                str(electron_repo),
            )

        run("git", "-C", str(electron_repo), "reset", "--hard")
        run("git", "-C", str(electron_repo), "clean", "-ffd")
        run(
            "git",
            "-C",
            str(electron_repo),
            "fetch",
            "--force",
            "origin",
            f"refs/tags/{tag}:refs/tags/{tag}",
        )
        run("git", "-C", str(electron_repo), "checkout", "--detach", "--force", tag)

        if command_succeeds("git", "-C", str(source_root), "rev-parse", "--git-dir"):
            run("git", "-C", str(source_root), "reset", "--hard")
        run("e", "sync", "--3")

        out_major_file = out_dir / ".electron-build-major"
        if not out_major_file.is_file() or out_major_file.read_text().strip() != major:
            shutil.rmtree(out_dir / "gen", ignore_errors=True)
            out_dir.mkdir(parents=True, exist_ok=True)
            out_major_file.write_text(f"{major}\n")

        patches.clear()
        for relative_patch in recipe.get("patches", []):
            apply_patch(electron_repo, repo_root / relative_patch, patches)

        run("git", "-C", str(electron_repo), "diff", "--check")
        run("e", "build", "--gen", "only")

        for relative_patch in recipe.get("chromiumPatches", []):
            apply_patch(source_root, repo_root / relative_patch, patches)

        run("git", "-C", str(source_root), "diff", "--check")
        build_args = ["--gen", "off", "--target", "electron:electron_dist_zip"]
        if os.environ.get("ELECTRON_BUILD_NO_REMOTE") == "1":
            build_args.append("--no-remote")
        run("e", "build", *build_args)

    build_sources()

    dist = out_dir / "dist.zip"
    if not dist.is_file() or dist.stat().st_size == 0:
        raise RuntimeError(f"missing build artifact: {dist}")

    upstream_commit = run(
        "git",
        "-C",
        str(electron_repo),
        "rev-parse",
        f"{tag}^{{commit}}",
        capture=True,
    ).stdout.strip()
    config_sha256 = sha256(repo_root / "config/evm.main-release.json")
    patches_json = json.dumps(patches, separators=(",", ":"))
    fingerprint = hashlib.sha256(
        "\n".join(["8", version, upstream_commit, config_sha256, patches_json, ""]).encode()
    ).hexdigest()[:20]
    dist_sha256 = sha256(dist)
    built_at = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    key_prefix = f"electron/{major}/{version}/{fingerprint}"
    public_url = f"{garage_public_base_url.rstrip('/')}/{key_prefix}/dist.zip"
    manifest = {
        "recipeVersion": 8,
        "major": int(major),
        "version": version,
        "upstreamTag": tag,
        "upstreamCommit": upstream_commit,
        "fingerprint": fingerprint,
        "sha256": dist_sha256,
        "size": dist.stat().st_size,
        "url": public_url,
        "builtAt": built_at,
        "configSha256": config_sha256,
        "patches": patches,
    }
    manifest_path = repo_root / "out" / major / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, indent=2) + "\n")

    os.environ["AWS_DEFAULT_REGION"] = garage_region
    if command_succeeds(
        "aws",
        "--endpoint-url",
        garage_endpoint,
        "s3api",
        "head-object",
        "--bucket",
        garage_bucket,
        "--key",
        f"{key_prefix}/dist.zip",
    ):
        raise RuntimeError(f"refusing to overwrite immutable artifact: {key_prefix}/dist.zip")

    run(
        "aws",
        "--endpoint-url",
        garage_endpoint,
        "s3",
        "cp",
        str(dist),
        f"s3://{garage_bucket}/{key_prefix}/dist.zip",
        "--content-type",
        "application/zip",
        "--no-progress",
    )
    run(
        "aws",
        "--endpoint-url",
        garage_endpoint,
        "s3",
        "cp",
        str(manifest_path),
        f"s3://{garage_bucket}/{key_prefix}/manifest.json",
        "--content-type",
        "application/json",
        "--no-progress",
    )
    run(
        "aws",
        "--endpoint-url",
        garage_endpoint,
        "s3",
        "cp",
        str(manifest_path),
        f"s3://{garage_bucket}/electron/{major}/latest.json",
        "--content-type",
        "application/json",
        "--cache-control",
        "no-cache, no-store, must-revalidate",
        "--no-progress",
    )
    print(json.dumps(manifest, indent=2))
    fcntl.flock(lock, fcntl.LOCK_UN)
    lock.close()
    return 0


try:
    raise SystemExit(main())
except (KeyError, RuntimeError, subprocess.CalledProcessError) as error:
    print(f"build failed: {error}", file=sys.stderr)
    raise SystemExit(1)

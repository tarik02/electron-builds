+#ifndef ELECTRON_SHELL_BROWSER_UI_VIEWS_GLOBAL_MENU_BAR_LINUX_H_
+#define ELECTRON_SHELL_BROWSER_UI_VIEWS_GLOBAL_MENU_BAR_LINUX_H_
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "shell/browser/ui/electron_menu_model.h"
+#include "ui/base/glib/scoped_gsignal.h"
+#include "ui/gfx/native_ui_types.h"
+
+typedef struct _DbusmenuMenuitem DbusmenuMenuitem;
+typedef struct _DbusmenuServer DbusmenuServer;
+
+namespace ui {
+class Accelerator;
+class PlatformWindow;
+}  // namespace ui
+
+namespace electron {
+
+// Exports Electron menu models over com.canonical.dbusmenu and attaches the
+// exported menu to the current Linux window using the matching window-system
+// backend.
+class GlobalMenuBarLinux {
+ public:
+  GlobalMenuBarLinux(ui::PlatformWindow* platform_window,
+                     gfx::AcceleratedWidget accelerated_widget);
+  ~GlobalMenuBarLinux();
+
+  GlobalMenuBarLinux(const GlobalMenuBarLinux&) = delete;
+  GlobalMenuBarLinux& operator=(const GlobalMenuBarLinux&) = delete;
+
+  void SetMenu(ElectronMenuModel* menu_model);
+  bool IsServerStarted() const;
+
+  // Called by NativeWindow when the underlying platform window is shown/hidden
+  // or otherwise needs to attach/detach from the exported D-Bus menu.
+  void OnWindowMapped(ui::PlatformWindow* platform_window);
+  void OnWindowUnmapped(ui::PlatformWindow* platform_window);
+
+ private:
+  enum class Backend {
+    kNone,
+    kWayland,
+    kX11,
+  };
+
+  static Backend GetBackend(ui::PlatformWindow* platform_window);
+  static std::string GetPathForId(uint32_t id);
+
+  void InitServer(const std::string& object_path);
+  void AttachToWindow(ui::PlatformWindow* platform_window);
+  void DetachFromWindow(ui::PlatformWindow* platform_window);
+  void BuildMenuFromModel(ElectronMenuModel* model, DbusmenuMenuitem* parent);
+  void RegisterAccelerator(DbusmenuMenuitem* item,
+                           const ui::Accelerator& accelerator);
+  void OnItemActivated(DbusmenuMenuitem* item, unsigned int timestamp);
+  void OnSubMenuShow(DbusmenuMenuitem* item);
+
+  const Backend backend_ = Backend::kNone;
+  const gfx::AcceleratedWidget accelerated_widget_;
+  const std::string object_path_;
+  const std::string service_name_;
+
+  raw_ptr<DbusmenuServer> server_ = nullptr;
+  bool attached_ = false;
+  std::vector<ScopedGSignal> signals_;
+};
+
+}  // namespace electron
+
+#endif  // ELECTRON_SHELL_BROWSER_UI_VIEWS_GLOBAL_MENU_BAR_LINUX_H_

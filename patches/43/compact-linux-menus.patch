diff --git a/ui/views/controls/menu/menu_config.h b/ui/views/controls/menu/menu_config.h
--- a/ui/views/controls/menu/menu_config.h
+++ b/ui/views/controls/menu/menu_config.h
@@ -175,6 +175,11 @@ struct VIEWS_EXPORT MenuConfig {
   // Radius of selection background on menu items.
   int item_corner_radius = 0;
 
+  // Insets applied to the painted selection background. The menu item's hit
+  // area remains unchanged.
+  int item_selection_vertical_inset = 0;
+  int item_selection_horizontal_inset = 0;
+
   // Anchor offset for touchable menus created by a touch event.
   int touchable_anchor_offset = 8;
 
diff --git a/ui/views/controls/menu/menu_config_linux.cc b/ui/views/controls/menu/menu_config_linux.cc
--- a/ui/views/controls/menu/menu_config_linux.cc
+++ b/ui/views/controls/menu/menu_config_linux.cc
@@ -10,6 +10,15 @@ namespace views {
 
 void MenuConfig::InitPlatform() {

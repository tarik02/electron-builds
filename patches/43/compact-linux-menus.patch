 }
 
 }  // namespace views
diff --git a/ui/views/controls/menu/menu_item_view.cc b/ui/views/controls/menu/menu_item_view.cc
--- a/ui/views/controls/menu/menu_item_view.cc
+++ b/ui/views/controls/menu/menu_item_view.cc
@@ -1268,17 +1268,24 @@ void MenuItemView::PaintButton(gfx::Canvas* canvas,
       } else {
         item_bounds.set_width(item_bounds.width() -
                               config.actionable_submenu_width - 1);
       }
     }
+    if (!menu_item_background_.has_value()) {
+      item_bounds.Inset(gfx::Insets::VH(
+          config.item_selection_vertical_inset,
+          config.item_selection_horizontal_inset));
+    }
     AdjustBoundsForRTLUI(&item_bounds);
-
+
-    ui::NativeTheme::MenuItemExtraParams menu_item_extra_params;
-    menu_item_extra_params.corner_radius =
-        menu_item_background_.has_value() ? menu_item_background_->corner_radius
-                                          : config.item_corner_radius;
-    GetNativeTheme()->Paint(
-        canvas->sk_canvas(), GetColorProvider(),
-        ui::NativeTheme::kMenuItemBackground, ui::NativeTheme::kHovered,
-        item_bounds, ui::NativeTheme::ExtraParams(menu_item_extra_params));
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setStyle(cc::PaintFlags::kFill_Style);
+    flags.setColor(GetColorProvider()->GetColor(
+        ui::kColorMenuItemBackgroundSelected));
+    canvas->DrawRoundRect(
+        item_bounds,
+        menu_item_background_.has_value() ? menu_item_background_->corner_radius
+                                          : config.item_corner_radius,
+        flags);
   }
 }
